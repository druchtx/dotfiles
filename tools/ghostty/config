command =zsh -lc "tmux attach-session || tmux new-session"

### theme
theme = Github Dark Dimmed
window-theme = dark
font-family = Fira Code
font-codepoint-map = U+3040-U+30FF,U+FF65-U+FF9F=HackGen
font-style = Regular
font-size = 13
adjust-cell-height = 38%
adjust-cell-width = 3%

### window
window-padding-balance = true
window-padding-x = 0
window-padding-y = 0
window-theme = auto
macos-titlebar-style = transparent
macos-option-as-alt = true
window-decoration = true
mouse-hide-while-typing

### key binding
# tmux manages windows; disable Ghostty-native creation.
keybind = cmd+t=ignore
keybind = cmd+n=ignore
keybind = cmd+d=ignore
keybind = shift+cmd+d=ignore
